# Copia este fichero a .env.local y rellena con los datos de tu proyecto
# Supabase (Project Settings → API). Ambas claves son públicas: la anon key
# está pensada para clientes y toda la seguridad real vive en las políticas
# RLS de supabase/migrations. Nunca pongas aquí la service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
